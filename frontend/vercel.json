{
  "functions": {
    "api/project.js": {
      "includeFiles": "dist/index.html",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/project/:id",
      "destination": "/api/project?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
