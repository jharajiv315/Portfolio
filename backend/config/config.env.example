# Backend Server Configuration Example
PORT=4000

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=portfolio_db
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_URI=postgresql://postgres:your_postgres_password@localhost:5432/portfolio_db

# Client Application Origins (CORS)
PORTFOLIO_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174

# Cloudinary Media Storage Configuration
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Authentication & Cookie Configuration
JWT_SECRET_KEY=your_secure_jwt_secret_key
JWT_EXPIRES=10d
COOKIE_EXPIRES=10
COOKIE_EXPIRE=10
